# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 비밀값(.env)은 커밋하지 않는다. 이름만 적은 .env.example은 커밋한다.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generate 결과(빌드 때마다 다시 만든다)
/lib/generated/

# 내 PC에만 두는 것
/workbench/private/
.claude/settings.local.json
CLAUDE.local.md
