// 표 설계 파일 — 5일차 실습 C에서 모델을 더한다.
// 표를 바꾼 뒤에는 npm run db:push 로만 DB에 반영한다(migrate는 쓰지 않는다).
// DB 주소는 이 파일이 아니라 prisma.config.ts · .env 에서 읽는다.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Buyer {
  id             String   @id
  name           String
  countryCode    String
  countryKo      String
  region         String
  industry       String
  paymentMethod  String
  termsDays      Int
  openArUsd      Int
  overdueUsd     Int
  pctAr31p       Float?
  oldestOpenDays Int
  avgDaysLate12m Float?
  pd30d          Float
  grade          String
  signals        String[]
  reviews        Review[]
  drafts         DunningDraft[]
}

model Review {
  id        Int      @id @default(autoincrement())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id])
  status    String
  memo      String
  reviewer  String
  createdAt DateTime @default(now())

  @@index([buyerId])
}

model DunningDraft {
  id         Int       @id @default(autoincrement())
  buyerId    String
  buyer      Buyer     @relation(fields: [buyerId], references: [id])
  stage      String    // D+7 · D+15 · D+30
  tone       String    // T1 · T2 · T3
  overdueUsd Int
  subject    String
  body       String
  summaryKo  String    // 승인자를 위한 한국어 한 줄
  checks     Json      // 가드레일 G1–G7 결과 7개
  status     String    @default("pending") // pending · approved · rejected · blocked
  decidedBy  String?
  decidedAt  DateTime?
  reason     String?
  createdAt  DateTime  @default(now())

  @@index([buyerId])
  @@index([status])
}

model AuditLog {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  actor  String   // 'AI(claude -p)' · 승인자 별명
  action String   // 초안 작성 · 초안 막힘 · 승인 · 반려
  target String   // 예: {바이어 번호} · 초안 #{번호}
  detail String
}
